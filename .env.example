# Environment variables for the ChildClimate Atlas pipeline.
# Copy this file to `.env` (which is .gitignored) and fill in keys for
# any sources you want to enable. Missing keys are handled gracefully:
# the pipeline skips the corresponding enrichment source and continues.

# Healthsites.io API key (optional enrichment source).
# Get a key from https://healthsites.io/ — create an account, then look
# for "API Access" on your profile page. The free tier comfortably covers
# our pull volume (full-country rebuilds run once per data refresh).
# Without this key the pipeline still works — it just skips Healthsites
# enrichment and uses OSM Overpass only.
HEALTHSITES_API_KEY=
